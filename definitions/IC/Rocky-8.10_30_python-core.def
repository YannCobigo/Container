Bootstrap: localimage
From: /serv/Container/sandboxes/Rocky-8.10_20_dev.sandbox

%labels
    Author Yann Cobigo
    Description Rocky 8.10 general scientific Python core layer

%files
    /serv/Container/sources/requirements-core.txt /opt/ic/softwares/python/requirements-core.txt
    /serv/Container/sources/requirements-core-exceptions.txt /opt/ic/softwares/python/requirements-core-exceptions.txt

%post
    set -euxo pipefail

    export LANG=en_US.UTF-8
    export LC_ALL=en_US.UTF-8

    dnf -y module enable python39
    dnf -y install python39 python39-devel python39-pip python39-setuptools python39-wheel swig gpgme-devel

    mkdir -p /opt/ic/softwares/python
    mkdir -p /opt/ic/modulefiles/python-core
    mkdir -p /opt/ic/share/logs/python-core

    python3.9 -m pip install --upgrade pip setuptools wheel setuptools-scm

    # GPG Python bindings are a known exception in this environment; see the
    # exception requirements file and ARCHITECTURE.md before enabling them.
    python3.9 -m pip install --no-cache-dir \
        -r /opt/ic/softwares/python/requirements-core.txt \
        2>&1 | tee /opt/ic/share/logs/python-core/install.log

    python3.9 -m pip check 2>&1 | tee -a /opt/ic/share/logs/python-core/install.log

    cat >/opt/ic/modulefiles/python-core/current <<'EOF2'
#%Module1.0
module-whatis "Python 3.9 core scientific stack"
set root /usr
prepend-path PATH /usr/bin
prepend-path CMAKE_PREFIX_PATH /opt/ic/softwares/python
setenv PYTHON_VERSION 3.9
EOF2

    dnf clean all
    rm -rf /var/cache/dnf/*

%environment
    export MODULEPATH=/opt/ic/modulefiles
    export PATH=/opt/ic/bin:/usr/bin:$PATH
    if [ -f /etc/profile.d/modules.sh ]; then
        . /etc/profile.d/modules.sh
    fi
    module use /opt/ic/modulefiles

%runscript
    exec /bin/bash "$@"
