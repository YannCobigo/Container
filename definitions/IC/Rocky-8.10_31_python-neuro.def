Bootstrap: localimage
From: /serv/Container/sandboxes/Rocky-8.10_30_python-core.sandbox

%labels
    Author Yann Cobigo
    Description Rocky 8.10 Python neuroimaging layer

%files
    /serv/Container/sources/requirements-neuro.txt /opt/ic/softwares/python/requirements-neuro.txt
    /serv/Container/sources/requirements-neuro-exceptions.txt /opt/ic/softwares/python/requirements-neuro-exceptions.txt

%post
    set -euxo pipefail

    export LANG=en_US.UTF-8
    export LC_ALL=en_US.UTF-8

    mkdir -p /opt/ic/softwares/python
    mkdir -p /opt/ic/modulefiles/python-neuro
    mkdir -p /opt/ic/share/logs/python-neuro

    python3.9 -m pip install --no-cache-dir \
        -r /opt/ic/softwares/python/requirements-neuro.txt \
        2>&1 | tee /opt/ic/share/logs/python-neuro/install.log

    python3.9 -m pip check 2>&1 | tee -a /opt/ic/share/logs/python-neuro/install.log

    cat >/opt/ic/modulefiles/python-neuro/current <<'EOF2'
#%Module1.0
module-whatis "Python 3.9 neuroimaging stack"
prepend-path PATH /usr/bin
setenv PYTHON_VERSION 3.9
EOF2

    dnf clean all
    rm -rf /var/cache/dnf/*

%environment
    export MODULEPATH=/opt/ic/modulefiles
    export PATH=/opt/ic/bin:/usr/bin:$PATH
    if [ -f /etc/profile.d/modules.sh ]; then
        . /etc/profile.d/modules.sh
    fi
    module use /opt/ic/modulefiles

%runscript
    exec /bin/bash "$@"
